root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.ui]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

indent_style = space
indent_size = 2
tab_width = 2

[*.{js,ts,tsx,css,scss,json,bson,md}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf
